FROM ghcr.io/revotale/ci/base:v0.1.5@sha256:6e63627e23192f3e6258776bc9eeca0cc42829b1c447bc252ece997541e73f09 AS source

WORKDIR /workspace

# Add project-specific tools here when Go and Task are not enough.

COPY go.mod go.sum ./
RUN go mod download

COPY . .

FROM source AS lint
RUN ["task", "lint"]

FROM source AS unit
RUN ["task", "test:unit"]
