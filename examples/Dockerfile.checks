FROM ghcr.io/revotale/ci/base:v0.1.8@sha256:c59b01e74acd309c9c775f594917df6d9f8cad93fdfa7f40408aebeb5140f414 AS source

WORKDIR /workspace

# Add project-specific tools here when Go and Task are not enough.

COPY go.mod go.sum ./
RUN go mod download

COPY . .

FROM source AS lint
RUN ["task", "lint"]

FROM source AS unit
RUN ["task", "test:unit"]
